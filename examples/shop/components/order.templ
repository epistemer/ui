package components

import "github.com/epistemer/ui"

var (
	RowActions = ui.NewSlot()
	OrderRowID = ui.NewID("order-row")
)

// OrderRow renders one row of an order table, placing its own RowActions
// slot inside the fill it gives to Dropdown (rule 5).
func OrderRow(o Order) templ.Component {
	return ui.Slotted(orderRow(o), RowActions)
}

templ orderRow(o Order) {
	<tr id={ OrderRowID.Key(o.ID) }>
		<td>{ o.ID }</td>
		<td>{ o.Customer }</td>
		<td>{ o.Total }</td>
		<td>
			@Dropdown("Actions") {
				@MenuItems {
					@RowActions.Place() {
						<button hx-delete={ "/orders/" + o.ID } hx-target={ "#" + OrderRowID.Key(o.ID) }>Delete</button>
					}
				}
			}
		</td>
	</tr>
}

// OrderTable renders a table of orders via OrderRow.
templ OrderTable(orders []Order) {
	<table>
		<thead>
			<tr>
				<th>Order ID</th>
				<th>Customer</th>
				<th>Total</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			for _, o := range orders {
				@OrderRow(o)
			}
		</tbody>
	</table>
}
