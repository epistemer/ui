package spike

import (
	"strconv"

	"github.com/epistemer/i18n"

	"github.com/epistemer/ui"
	"github.com/epistemer/ui/actions"
	"github.com/epistemer/ui/components"
	"github.com/epistemer/ui/elements"
	"github.com/epistemer/ui/forms"
	"github.com/epistemer/ui/icons"
	"github.com/epistemer/ui/inputs"
	"github.com/epistemer/ui/layout"
	"github.com/epistemer/ui/theme"
)

var fieldID = ui.NewID("sfield")

templ pageTmpl(th *theme.Theme, scripts templ.Component, title i18n.Ter, body templ.Component) {
	@layout.Document(title).Head(th.Head(), orNothing(scripts), spikeHead()) {
		@layout.App() {
			@layout.AppBrand {
				Bricks & Co
			}
			@layout.AppNav {
				@layout.NavItem(link(Prefix + "/order")) {
					Order form
				}
				@layout.NavItem(link(Prefix + "/table")) {
					Filters and dialog
				}
			}
			@layout.AppMain {
				@body
			}
		}
	}
}

templ spikeHead() {
	<link rel="stylesheet" href={ Prefix + "/assets/spike.css" }/>
	<script type="module" src={ Prefix + "/assets/spike.js" }></script>
}

templ orderPage(o *order, saved string) {
	@layout.PageHeader(i18n.Static("New order")) {
	}
	if saved != "" {
		@elements.Alert().Tone(elements.Success) {
			{ saved }
		}
	}
	<form id="order" method="post" enctype="multipart/form-data" action={ templ.SafeURL(Prefix + "/order") } hx-post={ Prefix + "/order" } hx-target="body" hx-select="main" hx-swap="innerHTML" novalidate>
		for c := range o.f.Controls() {
			@spikeField(c)
		}
		@uploadField(o.receipt, i18n.Static("Receipt"))
		@elements.Button().Submit() {
			Save
		}
	</form>
}

// spikeField is inputs.Field with the design's three new shapes.
templ spikeField(c forms.Control) {
	if r, ok := remoteOf(c.Path()); ok {
		@combobox(c, r)
	} else if c.Kind() == forms.KindList {
		@list(c)
	} else if c.Kind() == forms.KindGroup {
		@group(c, 0)
	} else {
		@inputs.Field(c)
	}
}

templ group(c forms.Control, n int) {
	<fieldset class="ui-group">
		<legend class="ui-group-legend">
			if n > 0 {
				{ itemText.T(ctx, n) }
			} else if c.Label() != nil {
				{ c.Label().T(ctx) }
			}
		</legend>
		for ch := range c.Children() {
			@spikeField(ch)
		}
		if n > 0 {
			<button type="button" class="ui-button ui-list-remove" data-ui-remove hidden>{ removeItem.T(ctx, n) }</button>
		}
	</fieldset>
}

templ list(c forms.Control) {
	{{ b := boundsOf(c.Path()) }}
	{{ n := 0 }}
	@ui.Scope(fieldID) {
		<fieldset class="ui-list" id={ fieldID.Get(ctx) }>
			<legend class="ui-group-legend">{ c.Label().T(ctx) }</legend>
			<ui-repeat data-ui-path={ c.Path() } data-ui-next={ strconv.Itoa(count(c)) } data-ui-min={ strconv.Itoa(b[0]) } data-ui-max={ strconv.Itoa(b[1]) } data-ui-texts={ listTexts(ctx) }>
				<ol class="ui-list-items">
					for ch := range c.Children() {
						{{ n++ }}
						<li class="ui-list-item">
							@group(ch, n)
						</li>
					}
				</ol>
				if t, ok := c.Template(); ok {
					<template>
						<li class="ui-list-item">
							@group(t, 1)
						</li>
					</template>
				}
				<button type="button" class="ui-button ui-list-add" data-ui-add hidden>{ addItem.T(ctx, c.Label()) }</button>
				<p class="ui-visually-hidden" role="status"></p>
			</ui-repeat>
			if err := c.Err(); err != nil {
				<p class="ui-field-error">{ errText(ctx, err) }</p>
			}
		</fieldset>
	}
}

// combobox renders the shape without script (§3.2); the script upgrades it.
templ combobox(c forms.Control, r remote) {
	{{ text := first(c.Text()) }}
	{{ name, err := chosen(ctx, c, r, text) }}
	if err != nil {
		@fail(err)
	} else {
		@ui.Scope(fieldID) {
			<div class="ui-field">
				<label class="ui-field-label" for={ fieldID.Get(ctx) }>
					{ c.Label().T(ctx) }
					if c.Required() {
						<span class="ui-field-required" aria-hidden="true">*</span>
					}
				</label>
				<ui-combobox class="ui-combobox" { comboAttrs(ctx, c, r)... }>
					<input { inputAttrs(ctx, c, text)... }/>
					<span class="ui-combobox-chosen" id={ fieldID.Part(ctx, "chosen") }>{ name }</span>
				</ui-combobox>
				if err := c.Err(); err != nil {
					<p class="ui-field-error" id={ fieldID.Part(ctx, "error") }>
						@icons.CircleX()
						{ errText(ctx, err) }
					</p>
				}
			</div>
		}
	}
}

// uploadField renders §4.3 by hand: Upload isn't in forms yet.
templ uploadField(u *upload, label i18n.Ter) {
	@ui.Scope(fieldID) {
		<div class="ui-field ui-upload" data-ui-texts={ uploadTexts(ctx) }>
			<label class="ui-field-label" for={ fieldID.Get(ctx) }>{ label.T(ctx) }</label>
			<p class="ui-field-help" id={ fieldID.Part(ctx, "help") }>PNG, JPEG or PDF, up to 1 MB</p>
			if u.lost {
				<p class="ui-field-help ui-upload-lost" id={ fieldID.Part(ctx, "lost") }>{ again.T(ctx) }</p>
			}
			if len(u.stored) > 0 {
				<ul class="ui-upload-files">
					for i, s := range u.stored {
						<li class="ui-upload-file">
							<input type="checkbox" name={ u.path + ".keep" } value={ s.Key } checked?={ u.kept(s.Key) } id={ fieldID.Part(ctx, "keep", strconv.Itoa(i)) }/>
							<label for={ fieldID.Part(ctx, "keep", strconv.Itoa(i)) }>
								if s.Href != nil && actions.Allowed(ctx, s.Href) {
									if s.Image {
										<img class="ui-upload-thumb" src={ s.Href.URL() } alt=""/>
									}
									{ keepText.T(ctx) } <a href={ templ.SafeURL(s.Href.URL()) }>{ s.Name }</a>
								} else {
									{ keepText.T(ctx) } { s.Name }
								}
							</label>
						</li>
					}
				</ul>
			}
			<input type="file" id={ fieldID.Get(ctx) } name={ u.path } class="ui-input ui-upload-input" multiple accept="image/png,image/jpeg,application/pdf" data-ui-max-size="1048576" aria-describedby={ describedBy(ctx, u.lost) }/>
			<ul class="ui-upload-chosen"></ul>
			<progress class="ui-upload-progress" max="100" hidden></progress>
			<p class="ui-visually-hidden" role="status"></p>
		</div>
	}
}

templ suggestions(opts []suggestion) {
	<ul data-ui-suggestions data-ui-more?={ len(opts) > SuggestionLimit }>
		for i, o := range opts {
			if i < SuggestionLimit {
				<li data-value={ o.Value }>{ o.Label.T(ctx) }</li>
			}
		}
	</ul>
}

templ assignBody(f *forms.Form) {
	@components.ActionTitle(i18n.Static("Assign a customer"))
	<form method="post" action={ templ.SafeURL(Prefix + "/assign") } hx-post={ Prefix + "/assign" } hx-target="#ui-action-dialog-body" hx-swap="innerHTML" novalidate>
		for c := range f.Controls() {
			@spikeField(c)
		}
		@elements.Button().Submit() {
			Save
		}
	</form>
}

templ tablePage(f *forms.Form, items []actions.Item) {
	@layout.PageHeader(i18n.Static("Filters and dialog")) {
		@components.ActionButtons(items)
	}
	<ui-table id="spike-table" class="ui-table" data-ui-own="filter.customer_id refused_id">
		<form id="spike-table-state" method="get" action={ templ.SafeURL(Prefix + "/table") } hx-get={ Prefix + "/table" } hx-target="#spike-table-results" hx-select="#spike-table-results" hx-swap="outerHTML" hx-push-url="true">
			for c := range f.Controls() {
				@spikeField(c)
			}
			@elements.Button().Submit() {
				Apply
			}
		</form>
		<div class="ui-table-results" id="spike-table-results">
			<p>Results for customer { resultsFor(f) }</p>
		</div>
	</ui-table>
}

templ signinPage() {
	@layout.PageHeader(i18n.Static("Sign in")) {
	}
	<p>The page an expired session is sent to.</p>
}
