package components

import (
	"github.com/epistemer/ui"
	"github.com/epistemer/ui/elements"
	"github.com/epistemer/ui/icons"
)

templ menu(m MenuSpec) {
	{{ requireItems(ctx) }}
	@ui.Scope(menuID) {
		{{ trigger, popover := m.ids(ctx) }}
		<ui-menu { elements.Merge(templ.Attributes{"class": "ui-menu"}, nil, m.attrs)... }>
			@MenuTrigger.Place(m.triggerAttrs(ctx)) {
				@elements.Button().Variant(elements.Outline).Tone(elements.Neutral).Attrs(MenuTrigger.Value(ctx)) {
					{ m.label.T(ctx) }
					@icons.ChevronDown()
				}
			}
			<div class="ui-menu-popover" id={ popover } popover role="menu" aria-labelledby={ trigger }>
				@MenuItems.Place()
			</div>
		</ui-menu>
	}
}

templ menuButton(attrs templ.Attributes) {
	<button { attrs... }>
		{ children... }
	</button>
}

templ menuLink(attrs templ.Attributes) {
	<a { attrs... }>
		{ children... }
	</a>
}

// unavailableItem renders an Unavailable item, inside its id scope: named
// by its label, described by its reason.
templ unavailableItem(m MenuItemSpec) {
	@ui.Scope(menuItemID) {
		<button { m.unavailableAttrs(ctx)... }>
			<span class="ui-menu-item-label" id={ menuItemID.Part(ctx, "label") }>
				{ children... }
			</span>
			<span class="ui-action-reason" id={ menuItemID.Part(ctx, "reason") }>{ m.reason.T(ctx) }</span>
		</button>
	}
}
