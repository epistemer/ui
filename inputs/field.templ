package inputs

import (
	"context"
	"strconv"

	"github.com/epistemer/errors"
	"github.com/epistemer/ui"
	"github.com/epistemer/ui/forms"
	"github.com/epistemer/ui/icons"
)

// field: label, help (above the control, so autocomplete and the
// on-screen keyboard don't cover it), the control, then the error.
templ field(f FieldSpec, wrapper templ.Attributes) {
	@ui.Scope(fieldID) {
		<div { wrapper... }>
			if f.isCheckboxRow() {
				@help(f)
				<div class="ui-field-row">
					<input { f.controlAttrs(ctx)... }/>
					@label(f)
				</div>
			} else {
				@label(f)
				@help(f)
				if f.isTristate() {
					<ui-tristate class="ui-tristate" data-ui-unset={ toggleUnset.T(ctx) }>
						@selectTag(f)
						<template class="ui-tristate-marks">
							@icons.Check()
							@icons.Minus()
							@icons.X()
						</template>
					</ui-tristate>
				} else if f.isSelect() {
					@selectTag(f)
				} else if f.c.Kind() == forms.KindMultiline {
					<textarea { f.controlAttrs(ctx)... }>{ f.textareaValue() }</textarea>
				} else if f.c.Kind() == forms.KindPassword {
					<div class="ui-field-row">
						<input { f.controlAttrs(ctx)... }/>
						@reveal(fieldID.Get(ctx))
					</div>
				} else {
					<input { f.controlAttrs(ctx)... }/>
				}
			}
			@fieldError(f)
		</div>
	}
}

templ help(f FieldSpec) {
	if f.c.Help() != nil {
		<p class="ui-field-help" id={ fieldID.Part(ctx, "help") }>{ f.c.Help().T(ctx) }</p>
	}
}

// fieldError starts with an icon and a hidden word, so an error isn't
// shown by colour alone.
templ fieldError(f FieldSpec) {
	if err := f.c.Err(); err != nil {
		<p class="ui-field-error" id={ fieldID.Part(ctx, "error") }>
			@icons.CircleX()
			<span class="ui-visually-hidden">{ errorWord.T(ctx) + " " }</span>
			{ errors.T(ctx, err) }
		</p>
	}
}

// reveal switches a password between hidden and shown, through the ui
// script; CSS hides it until the script has run.
templ reveal(input string) {
	<button type="button" class="ui-field-reveal" aria-controls={ input } aria-pressed="false" aria-label={ showPassword.T(ctx) } data-ui-reveal>
		@icons.Eye()
		@icons.EyeOff()
	</button>
}

templ selectTag(f FieldSpec) {
	{{ opts, empty := f.choices(ctx) }}
	<select { f.controlAttrs(ctx)... }>
		if empty {
			<option value="">{ choose.T(ctx) }</option>
		}
		for _, o := range opts {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label.T(ctx) }</option>
		}
	</select>
}

templ label(f FieldSpec) {
	<label class="ui-field-label" for={ fieldID.Get(ctx) }>
		if l := f.c.Label(); l != nil {
			{ l.T(ctx) }
		}
		if f.c.Required() {
			<span class="ui-field-required" aria-hidden="true">*</span>
		}
	</label>
}

templ group(f FieldSpec, children []FieldSpec, attrs func(context.Context) templ.Attributes) {
	@ui.Scope(fieldID) {
		<fieldset { attrs(ctx)... }>
			<legend class="ui-group-legend">
				if l := f.c.Label(); l != nil {
					{ l.T(ctx) }
				}
			</legend>
			@help(f)
			for _, c := range children {
				@c
			}
			@fieldError(f)
		</fieldset>
	}
}

templ hidden(f FieldSpec, wrapper templ.Attributes) {
	if len(wrapper) > 0 {
		<div { wrapper... }>
			<input { f.hiddenAttrs()... }/>
		</div>
	} else {
		<input { f.hiddenAttrs()... }/>
	}
}

templ remoteField(f FieldSpec, wrapper templ.Attributes, chosen string) {
	@ui.Scope(fieldID) {
		<div { wrapper... }>
			@label(f)
			@help(f)
			<ui-combobox { f.comboboxAttrs(ctx)... }>
				<input { f.controlAttrs(ctx)... }/>
				<span class="ui-combobox-chosen" id={ fieldID.Part(ctx, "chosen") }>{ chosen }</span>
				<button type="button" class="ui-combobox-clear" tabindex="-1" aria-label={ comboboxClear.T(ctx, f.labelText(ctx)) } hidden>×</button>
				<div class="ui-combobox-popup" popover="manual">
					<ul class="ui-combobox-options" role="listbox" id={ fieldID.Part(ctx, "options") } aria-label={ f.labelText(ctx) }></ul>
					<p class="ui-combobox-status"></p>
				</div>
				<p class="ui-visually-hidden" role="status"></p>
			</ui-combobox>
			@fieldError(f)
		</div>
	}
}

templ uploadField(f FieldSpec, wrapper templ.Attributes, stored []storedFile) {
	@ui.Scope(fieldID) {
		<div { wrapper... }>
			@label(f)
			@help(f)
			if f.c.Lost() {
				<p class="ui-field-help ui-upload-lost" id={ fieldID.Part(ctx, "lost") }>{ uploadAgain.T(ctx) }</p>
			}
			if f.c.Kind() == forms.KindUpload || f.c.Kind() == forms.KindUploads {
				<ul class="ui-upload-files">
					for i, s := range stored {
						<li class="ui-upload-file" data-ui-name={ s.file.Name }>
							if s.file.Image && s.href != "" {
								<img class="ui-upload-thumb" src={ string(s.href) } alt=""/>
							}
							<input type="checkbox" name={ f.c.Path() + ".keep" } value={ s.file.Key } checked?={ s.kept } id={ fieldID.Part(ctx, "keep", strconv.Itoa(i)) }/>
							<label for={ fieldID.Part(ctx, "keep", strconv.Itoa(i)) }>{ uploadKeep.T(ctx, s.file.Name) }</label>
							if s.href != "" {
								<a href={ s.href }>{ s.file.Name }</a>
							}
						</li>
					}
				</ul>
			}
			<input { f.controlAttrs(ctx)... }/>
			<ul class="ui-upload-chosen"></ul>
			<progress class="ui-upload-progress" max="100" hidden></progress>
			<p class="ui-visually-hidden" role="status"></p>
			@fieldError(f)
		</div>
	}
}

templ list(f FieldSpec, items []listItemData, tpl []FieldSpec, attrs func(context.Context) templ.Attributes) {
	{{ minB, maxB := f.c.Bounds() }}
	@ui.Scope(fieldID) {
		<fieldset { attrs(ctx)... }>
			<legend class="ui-group-legend">
				{ f.labelText(ctx) }
				if f.c.Required() {
					<span class="ui-field-required" aria-hidden="true">*</span>
				}
			</legend>
			@help(f)
			<ui-repeat data-ui-path={ f.c.Path() } data-ui-next={ strconv.Itoa(len(items)) } data-ui-min={ strconv.Itoa(minB) } data-ui-max={ strconv.Itoa(maxB) } data-ui-texts={ f.listTexts(ctx) }>
				<ol class="ui-list-items">
					for _, it := range items {
						@listItemRow(it.n, it.children)
					}
				</ol>
				if tpl != nil {
					<template>
						@listItemRow(1, tpl)
					</template>
				}
				<button type="button" class="ui-button ui-list-add" data-ui-add hidden>{ listAdd.T(ctx, f.labelText(ctx)) }</button>
				<p class="ui-visually-hidden" role="status"></p>
			</ui-repeat>
			@fieldError(f)
		</fieldset>
	}
}

templ listItemRow(n int, children []FieldSpec) {
	<li class="ui-list-item">
		<fieldset class="ui-group">
			<legend class="ui-group-legend">{ listItem.T(ctx, n) }</legend>
			for _, c := range children {
				@c
			}
			<button type="button" class="ui-button ui-list-remove" data-ui-remove hidden>{ listRemove.T(ctx, n) }</button>
		</fieldset>
	</li>
}
