package inputs

import (
	"context"

	"github.com/epistemer/errors"
	"github.com/epistemer/ui"
	"github.com/epistemer/ui/forms"
	"github.com/epistemer/ui/icons"
)

// field: label, help (above the control, so autocomplete and the
// on-screen keyboard don't cover it), the control, then the error.
templ field(f FieldSpec, wrapper templ.Attributes) {
	@ui.Scope(fieldID) {
		<div { wrapper... }>
			if f.c.Kind() == forms.KindCheckbox {
				@help(f)
				<div class="ui-field-row">
					<input { f.controlAttrs(ctx)... }/>
					@label(f)
				</div>
			} else {
				@label(f)
				@help(f)
				if f.isSelect() {
					@selectTag(f)
				} else if f.c.Kind() == forms.KindMultiline {
					<textarea { f.controlAttrs(ctx)... }>{ f.textareaValue() }</textarea>
				} else if f.c.Kind() == forms.KindPassword {
					<div class="ui-field-row">
						<input { f.controlAttrs(ctx)... }/>
						@reveal(fieldID.Get(ctx))
					</div>
				} else {
					<input { f.controlAttrs(ctx)... }/>
				}
			}
			@fieldError(f)
		</div>
	}
}

templ help(f FieldSpec) {
	if f.c.Help() != nil {
		<p class="ui-field-help" id={ fieldID.Part(ctx, "help") }>{ f.c.Help().T(ctx) }</p>
	}
}

// fieldError starts with an icon and a hidden word, so an error isn't
// shown by colour alone.
templ fieldError(f FieldSpec) {
	if err := f.c.Err(); err != nil {
		<p class="ui-field-error" id={ fieldID.Part(ctx, "error") }>
			@icons.CircleX()
			<span class="ui-visually-hidden">{ errorWord.T(ctx) + " " }</span>
			{ errors.T(ctx, err) }
		</p>
	}
}

// reveal switches a password between hidden and shown, through the ui
// script; CSS hides it until the script has run.
templ reveal(input string) {
	<button type="button" class="ui-field-reveal" aria-controls={ input } aria-pressed="false" aria-label={ showPassword.T(ctx) } data-ui-reveal>
		@icons.Eye()
		@icons.EyeOff()
	</button>
}

templ selectTag(f FieldSpec) {
	{{ opts, empty := f.choices(ctx) }}
	<select { f.controlAttrs(ctx)... }>
		if empty {
			<option value="">{ choose.T(ctx) }</option>
		}
		for _, o := range opts {
			<option value={ o.Value } selected?={ o.Selected }>{ o.Label.T(ctx) }</option>
		}
	</select>
}

templ label(f FieldSpec) {
	<label class="ui-field-label" for={ fieldID.Get(ctx) }>
		if l := f.c.Label(); l != nil {
			{ l.T(ctx) }
		}
		if f.c.Required() {
			<span class="ui-field-required" aria-hidden="true">*</span>
		}
	</label>
}

templ group(f FieldSpec, children []FieldSpec, attrs func(context.Context) templ.Attributes) {
	@ui.Scope(fieldID) {
		<fieldset { attrs(ctx)... }>
			<legend class="ui-group-legend">
				if l := f.c.Label(); l != nil {
					{ l.T(ctx) }
				}
			</legend>
			@help(f)
			for _, c := range children {
				@c
			}
			@fieldError(f)
		</fieldset>
	}
}

templ hidden(f FieldSpec, wrapper templ.Attributes) {
	if len(wrapper) > 0 {
		<div { wrapper... }>
			<input { f.hiddenAttrs()... }/>
		</div>
	} else {
		<input { f.hiddenAttrs()... }/>
	}
}
